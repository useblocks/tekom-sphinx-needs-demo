{
  "$defs": {
    "type-warn": {
      "properties": { "type": { "const": "warn" } }
    },
    "type-hazard": {
      "properties": { "type": { "const": "hazard" } }
    },
    "type-proc": {
      "properties": { "type": { "const": "proc" } }
    },
    "eigene-typen": {
      "properties": {
        "type": { "enum": ["term", "warn", "proc", "feature", "variant"] }
      }
    }
  },
  "schemas": [
    {
      "id": "warn-braucht-signalwort",
      "severity": "violation",
      "message": "Jeder Warnhinweis braucht ein Signalwort: GEFAHR, WARNUNG, VORSICHT oder ACHTUNG.",
      "select": { "$ref": "#/$defs/type-warn" },
      "validate": {
        "local": {
          "required": ["signalwort"],
          "properties": {
            "signalwort": {
              "type": "string",
              "enum": ["GEFAHR", "WARNUNG", "VORSICHT", "ACHTUNG"]
            }
          }
        }
      }
    },
    {
      "id": "warn-deckt-gefaehrdung",
      "severity": "violation",
      "message": "Jeder Warnhinweis muss ueber 'covers' auf mindestens eine Gefaehrdung verweisen.",
      "select": { "$ref": "#/$defs/type-warn" },
      "validate": {
        "local": {
          "required": ["covers"],
          "properties": {
            "covers": { "type": "array", "minItems": 1 }
          }
        },
        "network": {
          "covers": {
            "items": { "local": { "$ref": "#/$defs/type-hazard" } }
          }
        }
      }
    },
    {
      "id": "gefaehrdung-ist-abgedeckt",
      "severity": "violation",
      "message": "Zu dieser Gefaehrdung gibt es keinen Warnhinweis im Handbuch.",
      "select": { "$ref": "#/$defs/type-hazard" },
      "validate": {
        "network_back": {
          "covers": {
            "contains": { "local": { "$ref": "#/$defs/type-warn" } },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "freigegebenes-braucht-pruefdatum",
      "severity": "warning",
      "message": "Eine freigegebene Handlungsanweisung braucht ein Pruefdatum in 'geprueft_am'.",
      "select": {
        "allOf": [
          { "$ref": "#/$defs/type-proc" },
          { "properties": { "status": { "const": "freigegeben" } } }
        ]
      },
      "validate": {
        "local": {
          "required": ["geprueft_am"],
          "properties": { "geprueft_am": { "type": "string", "minLength": 1 } }
        }
      }
    },
    {
      "id": "status-ist-gueltig",
      "severity": "violation",
      "message": "Erlaubte Status sind entwurf, review und freigegeben.",
      "select": { "$ref": "#/$defs/eigene-typen" },
      "validate": {
        "local": {
          "properties": {
            "status": {
              "type": "string",
              "enum": ["entwurf", "review", "freigegeben"]
            }
          }
        }
      }
    }
  ]
}
